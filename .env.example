# Template for environment configuration. Copy and adjust.
#
#   cp .env.example .env.development    # local development
#   make secrets-template               # production (generates .env.production)
#
# Both copies are gitignored; this file is not. Never put a real secret here.
# All three files keep the same keys, order and section headers, so they diff
# cleanly against each other.

# ---- api ------------------------------------------------------------------

PORT=4000
CORS_ORIGINS=http://localhost:5173

# Required. The API has no in-memory fallback and will not boot without it.
# `make db-url` prints this for the local container.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sandbox_factory

# ---- auth -----------------------------------------------------------------
#
# All of these are required; the API will not boot without them.
#
# Signing secret for session tokens: openssl rand -base64 32
# Rotating it signs everyone out.
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters

# Public origin of the API. Better Auth builds the OAuth callback URLs from it,
# so it must match what is registered with each provider exactly.
BETTER_AUTH_URL=http://localhost:4000

# Public origin of the web app, where failed sign-ins are redirected so the
# error shows in the app. Defaults to the first CORS_ORIGINS entry.
# APP_URL=http://localhost:5173

# Google: https://console.cloud.google.com/apis/credentials
# OAuth 2.0 Client ID, type "Web application". Exact redirect URI:
#   http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
# New OAuth App. Authorization callback URL:
#   http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian: https://developer.atlassian.com/console/myapps/
# Create > OAuth 2.0 integration, access type **Resource-level** (account-level
# is broader than sign-in needs).
#
# Authorization > OAuth 2.0 (3LO) > Configure. Exact callback URL:
#   http://localhost:4000/api/auth/callback/atlassian
#
# Permissions: add the "User Identity API" and grant `read:me`, the only scope
# the API requests (plus offline_access). Without it the profile has no email
# and sign-in fails. Do not add the site-scoped Jira or Confluence APIs.
#
# Client ID and secret are under Settings.
#
# Atlassian returns no email_verified claim, so the API treats it as a trusted
# provider. See `trustedProviders` in apps/api/src/auth.ts.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Encrypts the Jira tokens stored in `jira_connection`. Required: the API
# refuses to start without it, so that no token can be written unencrypted.
# Generate with: openssl rand -base64 32
# Rotating it means re-encrypting those rows, not just replacing the value.
TOKEN_ENCRYPTION_KEY=

# Only when the web app and API are different subdomains of one parent, e.g.
# `.lunox.work` for app.lunox.work + api.lunox.work. Leave unset locally: a
# Domain attribute on localhost stops the cookie working at all.
# AUTH_COOKIE_DOMAIN=.lunox.work

# ---- origin verification --------------------------------------------------
#
# Shared secret the CDN sends on every origin request. Unset (the local
# default), the check is not installed. Set it only where the API is exposed
# directly to the internet, as in `infra/`: CloudFront reaches a Fargate task
# with no load balancer, and Terraform generates and injects the value.
# `/health` is exempt, so container and uptime probes keep working.
# ORIGIN_VERIFY=

# ---- object storage (SeaweedFS S3 gateway) --------------------------------
#
# Optional: unset, the API starts without object storage. All three of
# S3_ENDPOINT, S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY must be set together.
# `make s3-url` prints the endpoint for the local container.

S3_ENDPOINT=http://localhost:8333
S3_BUCKET=sandbox-factory
S3_ACCESS_KEY_ID=sandbox
S3_SECRET_ACCESS_KEY=sandboxsecret
# Ignored by SeaweedFS, but the S3 request signer requires a value.
S3_REGION=us-east-1

# ---- compose port overrides -----------------------------------------------
# Set these if a port is already in use on your machine.

# POSTGRES_PORT=5432
# S3_PORT=8333
# SEAWEED_FILER_PORT=8888
# API_PORT=4000
# WEB_PORT=5173
# WEB_PROD_PORT=8080
