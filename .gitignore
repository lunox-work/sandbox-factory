# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build output
dist/
dist-test/
build/
out/
*.tsbuildinfo

# Packaged VS Code extension (`make ext-package` output)
*.vsix

# Test / coverage
coverage/
.nyc_output/

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.npm
.eslintcache
.turbo/
.vite/
# Marks the lockfile the dev containers were last recreated for; `make up`
# compares timestamps against package-lock.json.
.docker-deps-stamp

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# Shared so F5 launches the extension without per-developer setup.
!.vscode/launch.json
!.vscode/tasks.json

# Terraform. State holds resource ids and the generated origin-verify secret.
# backend.hcl IS committed: it names a private bucket, not a credential.
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/tfplan
infra/plan.txt
infra/.terraform.tfstate.lock.info
# Variable files: a fork would inherit this account's settings, and one could
# hold a secret.
infra/*.auto.tfvars
infra/terraform.tfvars

# Working notes and drafts that stay on the machine they were written on.
*.local.md
docs/plan/
# Private, human-labelled sizing examples. Synthetic fixtures remain tracked.
apps/api/eval/*.jsonl
!apps/api/eval/*.synthetic.jsonl
