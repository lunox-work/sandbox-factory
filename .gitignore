# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Build output
dist/
dist-test/
build/
out/
*.tsbuildinfo

# Packaged VS Code extension — `make ext-package` output, a build artifact
*.vsix

# Test / coverage
coverage/
.nyc_output/

# Secrets and local config — keep these out of history from the very first commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches
.cache/
.npm
.eslintcache
.turbo/
.vite/

# Editors and OS
.DS_Store
Thumbs.db
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# Shared so F5 launches the extension without per-developer setup.
!.vscode/launch.json
!.vscode/tasks.json
