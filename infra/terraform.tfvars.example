# Copy to terraform.tfvars and fill in only what you need to override. That
# file is gitignored; this one is committed as a reference.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Every input has a working default in variables.tf, so this file is optional.

# Where alarm notifications go. Already defaulted to devops@lunox.work in
# variables.tf — override only for a separate environment.
#
# AWS sends a confirmation mail on the first apply that creates the
# subscription, and it delivers nothing until the link in it is clicked.
# alarm_email = "you@example.com"

# Raise for redundancy. One task means a single point of failure and a brief
# gap during every deploy; two removes both.
# api_desired_count = 2
