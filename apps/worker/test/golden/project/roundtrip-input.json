      "originalPath": "src/orvanta/fees.ts",
      "path": "src/northwind/fees.ts",
      "text": "/**\n * Fee rules: https://wiki.example/payments/fees\n * @author maintainer@example.com\n */\nimport type { LedgerEntry } from \"./ledger.js\";\n\n/** The flat Northwind charge on a debit, in cents. */\nconst flatCharge = 25;\n\n/** The Northwind fee on one entry, in cents: a flat charge on each withdrawal. */\nexport function entryFee(entry: LedgerEntry): number {\n  return entry.kind === \"debit\" ? flatCharge : 0;\n}\n"
    }
  ],
