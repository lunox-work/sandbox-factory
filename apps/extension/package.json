{
  "name": "sandbox-factory-vscode",
  "displayName": "sandbox-factory",
  "description": "sandbox-factory in VS Code.",
  "version": "0.0.1",
  "publisher": "lunox",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/sandbox-factory.git",
    "directory": "apps/extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sandboxFactory.openTask",
        "title": "sandbox-factory: Open Task"
      },
      {
        "command": "sandboxFactory.showTask",
        "title": "sandbox-factory: Show Task"
      },
      {
        "command": "sandboxFactory.installDependencies",
        "title": "sandbox-factory: Install Dependencies"
      },
      {
        "command": "sandboxFactory.runApp",
        "title": "sandbox-factory: Run App"
      },
      {
        "command": "sandboxFactory.runTests",
        "title": "sandbox-factory: Run Public Tests"
      },
      {
        "command": "sandboxFactory.signIn",
        "title": "sandbox-factory: Set API Token"
      },
      {
        "command": "sandboxFactory.showVersion",
        "title": "sandbox-factory: Show Version"
      }
    ],
    "configuration": {
      "title": "sandbox-factory",
      "properties": {
        "sandboxFactory.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:4000",
          "scope": "application",
          "description": "Base URL of the sandbox-factory API. A user or application setting: a workspace value is ignored so a repository cannot redirect authenticated requests."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=\"dist-test/src/**\" --test-coverage-exclude=\"dist-test/src/extension.js\" --test-coverage-exclude=\"dist-test/src/build.js\" --test dist-test/test/*.test.js > dist-test/coverage.txt; status=$?; cat dist-test/coverage.txt; [ $status -eq 0 ] && assert-all-covered dist-test/src dist-test/coverage.txt extension.js build.js host.js",
    "dev": "node esbuild.js --watch",
    "package": "npx --yes @vscode/vsce@3.6.0 package --no-dependencies"
  },
  "dependencies": {
    "@sandbox-factory/client": "*",
    "@sandbox-factory/shared": "*",
    "sandbox-factory": "*"
  },
  "devDependencies": {
    "@sandbox-factory/coverage": "*",
    "@sandbox-factory/tsconfig": "*",
    "@types/node": "^26.6.4",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Open Task and Show Task work anywhere. Install Dependencies, Run App and Run Public Tests run the task's npm scripts and need a trusted workspace."
    }
  }
}
