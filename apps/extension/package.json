{
  "name": "sandbox-factory-vscode",
  "displayName": "Lunox",
  "description": "Work on a Lunox contribution in VS Code: download it, run its tests, submit it and follow the verdict.",
  "version": "0.0.1",
  "publisher": "lunox",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/sandbox-factory.git",
    "directory": "apps/extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sandboxFactory.signIn",
        "title": "Sign in with a contributor token",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.signOut",
        "title": "Sign out",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.openContribution",
        "title": "Open contribution",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.previewSubmission",
        "title": "Preview submission",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.submit",
        "title": "Submit",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.gradeAgain",
        "title": "Grade again",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.refreshStatus",
        "title": "Refresh submission status",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.showSubmission",
        "title": "Show submission",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.openTask",
        "title": "Open project folder",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.showTask",
        "title": "Show task",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.installDependencies",
        "title": "Install dependencies",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.runApp",
        "title": "Run the walkthrough",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.runTests",
        "title": "Run public tests",
        "category": "Lunox"
      },
      {
        "command": "sandboxFactory.showVersion",
        "title": "Show version",
        "category": "Lunox"
      }
    ],
    "configuration": {
      "title": "Lunox",
      "properties": {
        "sandboxFactory.platformUrl": {
          "type": "string",
          "default": "https://platform.lunox.work",
          "scope": "application",
          "description": "Address of the Lunox platform (its web app and API). A user or application setting: a workspace value is ignored so a repository cannot redirect authenticated requests. Your contributor token is kept per address, in the OS keychain."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js --production",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf dist-test && tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-include=\"dist-test/src/**\" --test-coverage-exclude=\"dist-test/src/extension.js\" --test-coverage-exclude=\"dist-test/src/build.js\" --test dist-test/test/*.test.js > dist-test/coverage.txt; status=$?; cat dist-test/coverage.txt; [ $status -eq 0 ] && assert-all-covered dist-test/src dist-test/coverage.txt extension.js build.js host.js",
    "dev": "node esbuild.js --watch",
    "package": "npx --yes @vscode/vsce@3.6.0 package --no-dependencies"
  },
  "dependencies": {
    "@sandbox-factory/client": "*",
    "@sandbox-factory/shared": "*",
    "sandbox-factory": "*"
  },
  "devDependencies": {
    "@sandbox-factory/coverage": "*",
    "@sandbox-factory/tsconfig": "*",
    "@types/node": "^26.6.7",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Signing in, opening a contribution, previewing and submitting work anywhere. Install Dependencies, Run the walkthrough and Run Public Tests run the project's npm scripts and need a trusted workspace."
    }
  }
}
