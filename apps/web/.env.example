# Copy to .env and fill in. Never commit the real .env.

# Where the dev server proxies /api to. Defaults to http://localhost:4000.
VITE_API_URL=http://localhost:4000

# Extra dev hostnames, comma-separated; a leading dot allows subdomains.
# VITE_DEV_ALLOWED_HOSTS=

# Optional dev browser origin, shared with BETTER_AUTH_URL for OAuth cookies.
# VITE_DEV_CANONICAL_ORIGIN=
