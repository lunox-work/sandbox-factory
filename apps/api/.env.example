# Copy to .env and fill in. Never commit the real .env.

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API with credentials.
# The web dev server and the VS Code webview both need to be listed.
CORS_ORIGINS=http://localhost:5173

# Postgres connection string. Required — the API has no in-memory fallback.
#
# The value below matches what `make up` starts; `make db-url` prints it,
# including a non-default POSTGRES_PORT.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sandbox_factory

# ---- auth -----------------------------------------------------------------
#
# All required. See the repo-root .env.example for how to obtain each one and
# which redirect URI to register with each provider.

# openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4000

# Where failed sign-ins are sent. Defaults to the first CORS_ORIGINS entry.
# APP_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Sign-in only: "User Identity API" with `read:me`. See the root .env.example
# for why the Jira scopes must not go on this app.
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# A SECOND Atlassian 3LO app, for connecting a client's Jira site. Separate
# because a grant is per app and a new grant overwrites the old one's scopes,
# so sharing one app would make signing in and connecting Jira break each
# other. Callback: http://localhost:4000/api/v1/jira/callback
# Scopes: read:jira-work, read:jira-user (classic) plus
# read:board-scope:jira-software, read:sprint:jira-software (GRANULAR tab —
# Jira Software has no classic scopes, so they are not in the classic list).
# Full instructions in the root .env.example.
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Encrypts the Jira tokens stored in `jira_connection`. Required: the API
# refuses to start without it, so that no token can be written unencrypted.
# Generate with: openssl rand -base64 32
# Rotating it means re-encrypting those rows, not just replacing the value.
TOKEN_ENCRYPTION_KEY=

# Optional as a pair. No model identifier is assumed by the application.
ANTHROPIC_API_KEY=
SIZING_MODEL=

# The sizing fallback, optional as its own pair. Answers when an Anthropic
# call fails, or serves sizing alone when the pair above is unset.
DEEPSEEK_API_KEY=
DEEPSEEK_SIZING_MODEL=
# Only for a proxy or self-hosted gateway. Unset: https://api.deepseek.com
# DEEPSEEK_BASE_URL=

# Only when the web app and API are on different subdomains of one parent.
# AUTH_COOKIE_DOMAIN=.lunox.work
