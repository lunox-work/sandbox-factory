# Copy to .env and fill in. Never commit the real .env.

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API with credentials.
# The web dev server and the VS Code webview both need to be listed.
CORS_ORIGINS=http://localhost:5173

# Postgres connection string.
#
# Unused today — the API keeps todos in memory, so leaving this unset is the
# supported way to run it. It becomes required when packages/db lands.
#
# The value below matches what `make up` starts; `make db-url` prints it,
# including a non-default POSTGRES_PORT.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sandbox_factory
