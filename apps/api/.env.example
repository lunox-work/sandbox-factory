# Copy to .env and fill in. Never commit the real .env.

# Port the API listens on.
PORT=4000

# Comma-separated origins allowed to call the API with credentials.
# The web dev server and the VS Code webview both need to be listed.
CORS_ORIGINS=http://localhost:5173

# Postgres connection string. Unused by the in-memory store this scaffold
# ships with; required once packages/db lands.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/sandbox_factory
