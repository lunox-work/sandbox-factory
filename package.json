{
  "name": "@sandbox-factory/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo root. The publishable package lives in packages/core; releases are identified by git tag.",
  "license": "MIT",
  "author": "feversoul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/sandbox-factory.git"
  },
  "homepage": "https://github.com/lunox-work/sandbox-factory#readme",
  "bugs": {
    "url": "https://github.com/lunox-work/sandbox-factory/issues"
  },
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "tooling/*",
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || >=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "node --test scripts/test/*.test.cjs && turbo run test",
    "lint": "turbo run lint && npm run lint:deps",
    "lint:deps": "depcruise apps/*/src packages/*/src --config .dependency-cruiser.cjs --ignore-known",
    "dev": "turbo run dev --filter=@sandbox-factory/api --filter=@sandbox-factory/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run format:check && npm run build && npm test",
    "prepare": "husky",
    "test:e2e": "turbo run build --filter=@sandbox-factory/api --filter=@sandbox-factory/web && playwright test",
    "worker:smoke": "docker build --target runtime -f apps/worker/Dockerfile -t sandbox-factory-worker:smoke . && docker run --rm --entrypoint node sandbox-factory-worker:smoke apps/worker/scripts/smoke.mjs"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@playwright/test": "1.63.0",
    "@swc/core": "1.16.13",
    "dependency-cruiser": "18.5.0",
    "hono": "^4.13.11",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^7.0.2"
  },
  "keywords": []
}
