{
  "name": "sandbox-factory",
  "version": "0.1.0",
  "description": "One-sentence description of what sandbox-factory does.",
  "license": "MIT",
  "author": "feversoul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lunox-work/sandbox-factory.git"
  },
  "homepage": "https://github.com/lunox-work/sandbox-factory#readme",
  "bugs": {
    "url": "https://github.com/lunox-work/sandbox-factory/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 --test-coverage-exclude=\"dist-test/test/**\" --test dist-test/test/*.test.js",
    "lint": "tsc -p tsconfig.test.json --noEmit",
    "format": "prettier --write .",
    "verify": "npm run lint && prettier --check . && npm run build && npm test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "husky": "^9.1.7",
    "prettier": "^3.4.0",
    "typescript": "^7.0.2"
  },
  "keywords": []
}
