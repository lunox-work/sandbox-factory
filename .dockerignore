# Keeps the build context small and host artifacts out of images. Host-built
# node_modules (native modules, symlinks) do not transfer; every stage installs
# its own.

node_modules
**/node_modules

dist
**/dist
dist-test
**/dist-test
*.tsbuildinfo
.turbo
**/.turbo

.git
.github
.husky
.vscode

coverage
**/coverage

# Every env file: `.env.development` and `.env.production` hold real
# credentials and must never reach an image. Only the secret-free template
# stays.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!.env.example

*.vsix
**/out

.DS_Store
**/.DS_Store
*.log

Dockerfile
**/Dockerfile
docker-compose.yml
.dockerignore
